{
  "name": "flowi-desktop",
  "productName": "FLOWI",
  "version": "1.2.0",
  "description": "FLOWI — kassa kompyuteri uchun dastur (Windows 7/8/10/11, 32 va 64-bit)",
  "main": "main.js",
  "author": "FLOWI",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis-web nsis --x64 --ia32 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "uz.flowi.desktop",
    "productName": "FLOWI",
    "copyright": "FLOWI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "certs.js",
      "certs/**",
      "pages/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FLOWI",
      "artifactName": "FLOWI-Setup-Full-${version}.exe"
    },
    "nsisWeb": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FLOWI",
      "artifactName": "FLOWI-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/albusdumbledooree/albusdumbledooree/releases/download/desktop-v${version}"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.1.8"
  }
}
